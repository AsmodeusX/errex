# errexd settings on wp-vps. Rendered by render.sh; install as
# /etc/errex/errexd.env (root:errex 0640). No secrets here: the Telegram
# token is a systemd credential (/etc/errex/telegram_bot_token).

ERREX_DATA_DIR=/var/lib/errex
ERREX_HOST=::1
ERREX_PORT=9090
ERREX_MCP_HOST=::1
ERREX_PUBLIC_URL=https://@ERREX_HOSTNAME@
ERREX_LOG_LEVEL=info

# Ingest: DSN key required; per-project rate; deploy-time caps.
ERREX_REQUIRE_AUTH=true
ERREX_RATE_LIMIT_PER_MIN=600
ERREX_RATE_LIMIT_BURST=100
ERREX_RETENTION_DAYS=30
ERREX_EVENTS_PER_ISSUE_MAX=200
ERREX_ISSUES_PER_PROJECT_MAX=5000

# Login lockout reads CF-Connecting-IP, from Cloudflare or the local nginx.
ERREX_CLOUDFLARE_CLIENT_IP=true
ERREX_CLOUDFLARE_TRUSTED_PEERS=cloudflare,::1/128

# Telegram: the group or channel id (README "Telegram bot"). Required while
# errexd.service loads a token credential.
ERREX_TELEGRAM_CHAT_ID=
ERREX_TELEGRAM_MAX_PER_MIN=10

# First run only: the setup wizard's one-shot token. Remove after creating
# the first admin, then restart errexd.
# ERREX_ADMIN_TOKEN=
