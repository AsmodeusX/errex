# errexd settings on wp-vps. Rendered by render.sh; install as
# /etc/errex/errexd.env (root:errex 0640). No secrets here: the Telegram
# token is a systemd credential (/etc/errex/telegram_bot_token).

ERREX_DATA_DIR=/var/lib/errex
ERREX_HOST=::1
ERREX_PORT=9090
ERREX_MCP_HOST=::1
ERREX_PUBLIC_URL=https://@ERREX_HOSTNAME@
ERREX_LOG_LEVEL=info

# Ingest: DSN key required; per-project rate; deploy-time caps.
ERREX_REQUIRE_AUTH=true
ERREX_RATE_LIMIT_PER_MIN=600
ERREX_RATE_LIMIT_BURST=100
ERREX_RETENTION_DAYS=30
ERREX_EVENTS_PER_ISSUE_MAX=200
ERREX_ISSUES_PER_PROJECT_MAX=5000

# Login lockout reads CF-Connecting-IP, from Cloudflare or the local nginx.
ERREX_CLOUDFLARE_CLIENT_IP=true
ERREX_CLOUDFLARE_TRUSTED_PEERS=cloudflare,::1/128

# Telegram: the group or channel id (README "Telegram bot"). Required while
# errexd.service loads a token credential.
ERREX_TELEGRAM_CHAT_ID=
ERREX_TELEGRAM_MAX_PER_MIN=10
# Only error and fatal issues are alerted (pages always are).
ERREX_TELEGRAM_MIN_LEVEL=error

# Events the Zeus app sends for the user's own situation, dropped at ingest
# (answered 200, never stored): the app stops sending them itself from build
# 5, and this keeps builds already in the field quiet. A wrong password or
# code, signed out, not found, rate-limited; a successful flash; the
# adapter gone, the car silent or timing out; an NRC for the car's
# conditions (busy, engine running, voltage); a flash that stopped for one
# of those before anything was erased.
ERREX_DROP_EVENTS=licensing_refused:api.status=401|403|404|409|410|429;licensing_refused:api.code=invalid_code|invalid_email|weak_password|invalid_label|invalid_vin|invalid_donor_vin|reason_required|reason_too_long|reference_required|cloud_consent_required;flash_ok;flash_recovered;transport_adapter_disconnected;transport_session_closed;transport_adapter_closed;transport_can_disconnected;transport_can_closed;transport_slcan_closed;transport_ecu_silent;transport_timeout;transport_socket;transport_state_error;nrc:nrc.code=0x21|0x22|0x23|0x37|0x78|0x81|0x82|0x83|0x84|0x85|0x86|0x87|0x88|0x89|0x8a|0x8b|0x8c|0x8d|0x8e|0x8f|0x90|0x91|0x92|0x93;logging_interrupted:error.code=adapter_disconnected|session_closed|adapter_closed|can_disconnected|can_closed|slcan_closed|ecu_silent|timeout|socket;flash_interrupted:recovery.erase_requested=false;flash_failed:flash.erased=false,error.code=adapter_disconnected|session_closed|adapter_closed|can_disconnected|can_closed|slcan_closed|ecu_silent|timeout|socket;flash_failed:flash.erased=false,flash.nrc=0x21|0x22|0x23|0x37|0x78|0x81|0x82|0x83|0x84|0x85|0x86|0x87|0x88|0x89|0x8a|0x8b|0x8c|0x8d|0x8e|0x8f|0x90|0x91|0x92|0x93

# First run only: the setup wizard's one-shot token. Remove after creating
# the first admin, then restart errexd.
# ERREX_ADMIN_TOKEN=
