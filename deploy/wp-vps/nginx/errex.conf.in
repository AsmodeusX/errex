# errex on wp-vps, for @ERREX_HOSTNAME@. Rendered by deploy/wp-vps/render.sh.
#
# Cloudflare (proxied AAAA, Full strict) -> nginx [::]:443 -> errexd [::1]:9090
#
# Public: POST /api/<project>/envelope/ and nothing else.
# Everything else (the dashboard, /api, /ws, /setup, /health, /metrics) is
# behind a Cloudflare Access application and the header gate below.
# The origin answers Cloudflare's edge only (here, and in ufw).
#
# Relies on /etc/nginx/conf.d/cloudflare-trust.conf (already on wp-vps) for
# `set_real_ip_from <Cloudflare ranges>` at http level.

# The TCP peer, before realip rewrites $remote_addr, is Cloudflare's edge.
geo $realip_remote_addr $errex_from_cloudflare {
    default 0;
    include /etc/nginx/snippets/cloudflare-origin-geo.conf;
}

# Requests Cloudflare Access let through carry its JWT. nginx does not verify
# it; Access does. This catches an Access application that is missing,
# paused or scoped wrongly, so the dashboard is never open by accident.
map $http_cf_access_jwt_assertion $errex_dashboard_ok {
    ""      0;
    default 1;
}

# Per-client ingest limit, keyed on the address Cloudflare reports. The key
# lives in shared memory only; the ingest location logs nothing.
limit_req_zone $binary_remote_addr zone=errex_ingest:1m rate=30r/m;

upstream errexd {
    server [::1]:9090;
    keepalive 4;
}

server {
    listen [::]:443 ssl http2;
    server_name @ERREX_HOSTNAME@;

    # Cloudflare Origin CA certificate (README step "Origin certificate").
    ssl_certificate     /etc/ssl/cloudflare/@ERREX_HOSTNAME@.pem;
    ssl_certificate_key /etc/ssl/cloudflare/@ERREX_HOSTNAME@.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Authenticated Origin Pulls (optional README step): only Cloudflare can
    # complete the TLS handshake at all.
    # ssl_client_certificate /etc/ssl/cloudflare/authenticated_origin_pull_ca.pem;
    # ssl_verify_client on;

    real_ip_header CF-Connecting-IP;

    if ($errex_from_cloudflare = 0) {
        return 444;
    }

    client_max_body_size 1m;
    access_log /var/log/nginx/errex.access.log;
    error_log /var/log/nginx/errex.error.log warn;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For "";
    # After realip this is the client address Cloudflare reported. errexd
    # believes it from [::1] only (ERREX_CLOUDFLARE_TRUSTED_PEERS) and uses
    # it for the login lockout.
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header Connection "";

    # ----- public: SDK ingest -----
    location ~ ^/api/[A-Za-z0-9._-]+/envelope/$ {
        limit_except POST {
            deny all;
        }
        # No client address reaches a log or the daemon on this route.
        access_log off;
        error_log /var/log/nginx/errex.error.log crit;
        limit_req zone=errex_ingest burst=10 nodelay;
        limit_req_status 429;
        error_page 429 = @errex_rate_limited;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Connection "";
        proxy_read_timeout 15s;
        proxy_pass http://errexd;
    }

    location @errex_rate_limited {
        access_log off;
        add_header Retry-After 60 always;
        add_header X-Sentry-Rate-Limits "60::key" always;
        return 429;
    }

    # ----- restricted: dashboard, API, WebSocket, setup -----
    location /ws/ {
        if ($errex_dashboard_ok = 0) {
            return 403;
        }
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
        proxy_pass http://errexd;
    }

    location / {
        if ($errex_dashboard_ok = 0) {
            return 403;
        }
        proxy_pass http://errexd;
    }
}
